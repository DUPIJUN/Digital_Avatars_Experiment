        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="val = help_slider.getRating();&amp;#10;if ((val === null)) {&amp;#10;    val = 0;&amp;#10;}&amp;#10;wait_duration = ((val / 100.0) * 15);&amp;#10;wait_timer = new util.Clock();&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="# 拿到刚才的分数并转化为秒&amp;#10;val = help_slider.getRating()&amp;#10;if val is None: val = 0&amp;#10;wait_duration = (val / 100.0) * 15&amp;#10;wait_timer = core.Clock()" valType="extendedCode" updates="constant" name="Begin Routine"/>
