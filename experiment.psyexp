      <CodeComponent name="prac_stim_code" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="mouse = new psychoJS.eventManager.Mouse({&quot;visible&quot;: true, &quot;win&quot;: psychoJS.window});&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="mouse = event.Mouse(visible=True, win=win)" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="# --- 1. 逻辑跳转 ---&amp;#10;keys = event.getKeys(keyList=['space'])&amp;#10;if 'space' in keys and t &gt;= 3.0:&amp;#10;    # 获取评分&amp;#10;    prac_r1 = prac_pain_slider.getRating()&amp;#10;    prac_r2 = prac_help_slider.getRating()&amp;#10;    &amp;#10;    if prac_r1 is not None and prac_r2 is not None:&amp;#10;        continueRoutine = False" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="var _pj;&amp;#10;function _pj_snippets(container) {&amp;#10;    function in_es6(left, right) {&amp;#10;        if (((right instanceof Array) || ((typeof right) === &quot;string&quot;))) {&amp;#10;            return (right.indexOf(left) &gt; (- 1));&amp;#10;        } else {&amp;#10;            if (((right instanceof Map) || (right instanceof Set) || (right instanceof WeakMap) || (right instanceof WeakSet))) {&amp;#10;                return right.has(left);&amp;#10;            } else {&amp;#10;                return (left in right);&amp;#10;            }&amp;#10;        }&amp;#10;    }&amp;#10;    container[&quot;in_es6&quot;] = in_es6;&amp;#10;    return container;&amp;#10;}&amp;#10;_pj = {};&amp;#10;_pj_snippets(_pj);&amp;#10;keys = psychoJS.eventManager.getKeys({&quot;keyList&quot;: [&quot;space&quot;]});&amp;#10;if ((_pj.in_es6(&quot;space&quot;, keys) &amp;&amp; (t &gt;= 3.0))) {&amp;#10;    prac_r1 = prac_pain_slider.getRating();&amp;#10;    prac_r2 = prac_help_slider.getRating();&amp;#10;    if (((prac_r1 !== null) &amp;&amp; (prac_r2 !== null))) {&amp;#10;        continueRoutine = false;&amp;#10;    }&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="prac_score = prac_help_slider.getRating();&amp;#10;if ((prac_score !== null)) {&amp;#10;    if ((prac_score &lt;= 32)) {&amp;#10;        prac_next_vid = NODIFFERENCE_PATH;&amp;#10;    } else {&amp;#10;        if ((prac_score &lt;= 65)) {&amp;#10;            prac_next_vid = MODERATE_PATH;&amp;#10;        } else {&amp;#10;            prac_next_vid = RELIEF_PATH;&amp;#10;        }&amp;#10;    }&amp;#10;} else {&amp;#10;    prac_next_vid = NODIFFERENCE_PATH;&amp;#10;}&amp;#10;psychoJS.experiment.addData(&quot;prac_feedback_video_used&quot;, prac_next_vid);&amp;#10;prac_movie.stop();&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="# 1. 获取参与者在帮助意愿量表上的得分&amp;#10;# help_slider 是给量表起的名字&amp;#10;prac_score = prac_help_slider.getRating()&amp;#10;&amp;#10;# 2. 根据得分区间，从Excel的列中选择对应的路径&amp;#10;# 这些变量名（nodiff_path等）必须和 Excel 的表头完全一致&amp;#10;if prac_score is not None:&amp;#10;    if prac_score &lt;= 32:&amp;#10;        prac_next_vid = NODIFFERENCE_PATH&amp;#10;    elif prac_score &lt;= 65:&amp;#10;        prac_next_vid = MODERATE_PATH&amp;#10;    else:&amp;#10;        prac_next_vid = RELIEF_PATH&amp;#10;else:&amp;#10;    # 防止极端情况（没有点击就跳过了），默认给个不缓解&amp;#10;    prac_next_vid = NODIFFERENCE_PATH&amp;#10;&amp;#10;# 3. 把这个路径存入数据文件，方便以后进行分析&amp;#10;thisExp.addData('prac_feedback_video_used', prac_next_vid)&amp;#10;&amp;#10;# 每一轮结束都强制让播放器“归零”，释放内存&amp;#10;prac_movie.stop() &amp;#10;" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="prac_stim_code" valType="code" updates="None" name="name"/>
      </CodeComponent>
    </Routine>
    <Routine name="prac_waiting">
      <RoutineSettingsComponent name="prac_waiting" plugin="None">
        <Param val="none" valType="str" updates="None" name="backgroundFit"/>
